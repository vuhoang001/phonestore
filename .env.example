# Sao chép file này thành .env rồi điền giá trị thật. .env đã bị .gitignore bỏ qua.

# Tài khoản admin bootstrap
ADMIN_EMAIL=admin@phone.com
ADMIN_PASSWORD=Admin@123

# JWT (>= 32 ký tự)
JWT_SECRET=CHANGE_ME_super_secret_key_at_least_32_chars_long_1234567890

# MinIO
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_PUBLIC_URL=http://localhost:9000

# VNPay sandbox (đăng ký tại https://sandbox.vnpayment.vn/devreg/)
VNPAY_TMNCODE=YOUR_TMNCODE
VNPAY_HASHSECRET=YOUR_HASHSECRET

# SMTP Gmail (dùng App Password) — để trống nếu chỉ ghi log email
EMAIL_PROVIDER=Log
SMTP_USER=
SMTP_PASS=
